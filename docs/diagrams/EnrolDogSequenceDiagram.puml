@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF
skinparam maxMessageSize 180

participant "command:EnrolDogCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR

[-> Command : execute(model)
Command -> Model : enrolDogs(activityId, date, dogIds)
note right of Model
  Validates every requested dog and occurrence,
  duplicate bookings and time conflicts
  before adding any dated enrolments.
  Refreshes displayed records.
end note
[<-- Command : commandResult

legend bottom
  Enrols one batch of dogs. Model internals are omitted.
  Parsing and saving follow the shared Logic flow.
  Successful execution only; validation failures are omitted.
endlegend
@enduml
