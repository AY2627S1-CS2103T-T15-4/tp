@startuml
!include style.puml
skinparam arrowColor LOGIC_COLOR_T4

actor User
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":WatchDogParser" as Router LOGIC_COLOR
participant ":EnrolDogCommandParser" as Parser LOGIC_COLOR
participant "command:EnrolDogCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR
participant ":WatchDog" as Book MODEL_COLOR

User -> Logic : execute("enrol d/2  3 date/2028-02-29 a/1")
Logic -> Router : parseCommand(...)
Router -> Parser : parse("d/2  3 date/2028-02-29 a/1")
Parser -> Parser : parse activity ID, date and dog IDs
Parser -> Command : new EnrolDogCommand(1, 2028-02-29, [2, 3])
Parser --> Router : command
Router --> Logic : command
Logic -> Command : execute(Model)
Command -> Model : enrolDogs(1, 2028-02-29, [2, 3])
Model -> Book : enrolDogs(1, 2028-02-29, [2, 3])
Book -> Book : validate occurrence, dogs, duplicates and time conflicts
Book --> Model : success or EnrolException
Model --> Command : result
Command --> Logic : CommandResult
Logic --> User : display result
@enduml
