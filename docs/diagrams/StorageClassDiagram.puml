@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR_T4
skinparam classBackgroundColor STORAGE_COLOR
show members

class "<<interface>>\nStorage" as Storage
class StorageManager
class JsonUserPrefsStorage
class JsonAddressBookStorage
class JsonSerializableAddressBook
class JsonAdaptedCustomer
class JsonAdaptedDog {
  -ownerId: Integer
}
class JsonAdaptedActivity
class JsonAdaptedEnrolment {
  -activityId: Integer
  -dogId: Integer
  -date: LocalDate
}

StorageManager .up.|> Storage
StorageManager --> "1" JsonUserPrefsStorage : userPrefsStorage
StorageManager --> "1" JsonAddressBookStorage : addressBookStorage
JsonAddressBookStorage ..> JsonSerializableAddressBook : reads / writes
JsonSerializableAddressBook --> "*" JsonAdaptedCustomer : customers
JsonSerializableAddressBook --> "*" JsonAdaptedDog : dogs
JsonSerializableAddressBook --> "*" JsonAdaptedActivity : activities
JsonSerializableAddressBook --> "*" JsonAdaptedEnrolment : enrolments

@enduml
