@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor STORAGE_COLOR
skinparam classBackgroundColor STORAGE_COLOR

package Storage as StoragePackage {

Class "<<interface>>\nStorage" as Storage
Class StorageManager

package "UserPrefs Storage" #F4F6F6{
Class JsonUserPrefsStorage
}

package "WatchDog Storage" #F4F6F6{
Class JsonWatchDogStorage
Class JsonSerializableWatchDog
Class JsonAdaptedCustomer
Class JsonAdaptedDog
Class JsonAdaptedActivity
Class JsonAdaptedEnrolment
Class NextDogIdDeserializer
}

}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Storage

StorageManager .up.|> Storage
StorageManager -down-> "1" JsonUserPrefsStorage
StorageManager -down-> "1" JsonWatchDogStorage

JsonWatchDogStorage ..> JsonSerializableWatchDog
JsonSerializableWatchDog --> "*" JsonAdaptedCustomer
JsonSerializableWatchDog --> "*" JsonAdaptedDog
JsonSerializableWatchDog --> "*" JsonAdaptedActivity
JsonSerializableWatchDog --> "*" JsonAdaptedEnrolment
JsonSerializableWatchDog ..> NextDogIdDeserializer : validates nextDogId
JsonAdaptedEnrolment : activityId: int
JsonAdaptedEnrolment : dogId: int
JsonAdaptedEnrolment : date: LocalDate

@enduml
