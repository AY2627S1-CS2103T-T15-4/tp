@startuml
!include style.puml
skinparam arrowColor LOGIC_COLOR_T4

actor User
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Router LOGIC_COLOR
participant ":FilterDogCommandParser" as Parser LOGIC_COLOR
participant "command:FilterDogCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR
participant ":AddressBook" as Book MODEL_COLOR

User -> Logic : execute("filterd n/Waffle")
Logic -> Router : parseCommand(...)
Router -> Parser : parse(" n/Waffle")
Parser -> Command : new FilterDogCommand(...)
Parser --> Router : command
Router --> Logic : command
Logic -> Command : execute(Model)
Command -> Model : updateFilteredDogList(dogPredicate)
Command -> Model : updateFilteredCustomerList(owner of matching dog)
Command -> Model : updateFilteredActivityList(has matching enrolled dog)
Model -> Book : get enrolment records
Book --> Model : activity ID and dog ID pairs
Model --> Command : refresh filtered views
Command --> Logic : CommandResult
Logic --> User : display success message and views
@enduml
