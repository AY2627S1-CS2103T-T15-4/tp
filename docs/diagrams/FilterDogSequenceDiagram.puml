@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF
skinparam maxMessageSize 180

participant "command:FilterDogCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR

[-> Command : execute(model)
note over Command
  Builds dogPredicate for name Waffle.
  Related predicates follow current dog ownership
  and dated enrolment records.
end note
Command -> Model : updateFilteredDogList(dogPredicate)
Command -> Model : updateFilteredCustomerList(ownerPredicate)
Command -> Model : updateFilteredActivityList(enrolledActivityPredicate)
note right of Model
  Retains predicates for later refreshes.
  Stored records are unchanged.
end note
[<-- Command : commandResult

legend bottom
  Filters by name without an ID criterion. Predicate evaluation is omitted.
  Parsing and saving follow the shared Logic flow.
  Successful execution only; validation failures are omitted.
endlegend
@enduml
