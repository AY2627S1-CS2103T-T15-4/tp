@startuml
!include style.puml
skinparam arrowColor LOGIC_COLOR_T4

actor User
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Router LOGIC_COLOR
participant ":MarkActivityCommandParser" as Parser LOGIC_COLOR
participant "command:MarkActivityCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR
participant ":AddressBook" as Book MODEL_COLOR

User -> Logic : execute("mark 1")
Logic -> Router : parseCommand(...)
Router -> Parser : parse("1")
Parser -> Command : new MarkActivityCommand(1)
Parser --> Router : command
Router --> Logic : command
Logic -> Command : execute(Model)
Command -> Model : markActivity(1)
Model -> Book : markActivity(1)
Book -> Book : replace activity with completed copy
Book --> Model : success or ActivityNotFoundException
Model --> Command : result
Command --> Logic : CommandResult
Logic --> User : display result
@enduml
