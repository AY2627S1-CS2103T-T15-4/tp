@startuml
!include style.puml
skinparam arrowThickness 1.1
/'
// @@author Kenneth-Chia
'/
skinparam arrowColor MODEL_COLOR_T4
/'
// @@author
'/
skinparam classBackgroundColor MODEL_COLOR
/'
// @@author Kenneth-Chia
'/
show members
/'
// @@author
'/

/'
// @@author Kenneth-Chia
'/
class "<<interface>>\nModel" as Model
class ModelManager
class "<<interface>>\nReadOnlyWatchDog" as ReadOnlyWatchDog
class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
/'
// @@author
'/
class WatchDog
/'
// @@author Kenneth-Chia
'/
class UserPrefs
class UniqueCustomerList
class UniqueDogList
class Customer {
  -id: int
}
class Dog {
  -id: int
  -ownerId: Integer
}
class Activity {
  -id: int
}
class Enrolment {
  -activityId: int
  -dogId: int
  -date: LocalDate
/'
// @@author
'/
}

/'
// @@author Kenneth-Chia
'/
ModelManager .up.|> Model
ModelManager --> "1" WatchDog : watchDog
ModelManager --> "1" UserPrefs : userPrefs
Model ..> ReadOnlyWatchDog : exposes
Model ..> ReadOnlyUserPrefs : exposes
WatchDog .up.|> ReadOnlyWatchDog
UserPrefs .up.|> ReadOnlyUserPrefs
WatchDog --> "1" UniqueCustomerList : customers
WatchDog --> "1" UniqueDogList : dogs
WatchDog --> "*" Activity : activities
WatchDog --> "*" Enrolment : enrolments
UniqueCustomerList --> "*" Customer
UniqueDogList --> "*" Dog

note bottom of ModelManager
  Maintains filtered observable views of
  customers, dogs and activities.
  Views share the stored records.
end note

note bottom of Dog
  ownerId is null for an unlinked dog.
  Ownership and enrolment endpoints use IDs,
  not direct references to other records.
  Other record details and APIs are omitted.
end note
/'
// @@author
'/
@enduml
