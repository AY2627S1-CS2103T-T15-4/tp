@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR
show members

class "<<interface>>\nModel" as Model
class ModelManager
class "<<interface>>\nReadOnlyAddressBook" as ReadOnlyAddressBook
class "<<interface>>\nReadOnlyUserPrefs" as ReadOnlyUserPrefs
class AddressBook
class UserPrefs
class UniqueCustomerList
class UniqueDogList
class Customer {
  -id: int
}
class Dog {
  -id: int
  -ownerId: Integer
}
class Activity {
  -id: int
}
class Enrolment {
  -activityId: int
  -dogId: int
  -date: LocalDate
}

ModelManager .up.|> Model
ModelManager --> "1" AddressBook : addressBook
ModelManager --> "1" UserPrefs : userPrefs
Model ..> ReadOnlyAddressBook : exposes
Model ..> ReadOnlyUserPrefs : exposes
AddressBook .up.|> ReadOnlyAddressBook
UserPrefs .up.|> ReadOnlyUserPrefs
AddressBook --> "1" UniqueCustomerList : customers
AddressBook --> "1" UniqueDogList : dogs
AddressBook --> "*" Activity : activities
AddressBook --> "*" Enrolment : enrolments
UniqueCustomerList --> "*" Customer
UniqueDogList --> "*" Dog

note bottom of ModelManager
  Maintains filtered observable views of
  customers, dogs and activities.
  Views share the stored records.
end note

note bottom of Dog
  ownerId is null for an unlinked dog.
  Ownership and enrolment endpoints use IDs,
  not direct references to other records.
  Other record details and APIs are omitted.
end note
@enduml
