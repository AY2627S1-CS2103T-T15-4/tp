@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

package Model {
interface ReadOnlyAddressBook
interface ReadOnlyUserPrefs
interface Model
class ModelManager
class AddressBook
class UserPrefs
class UniqueCustomerList
class UniqueDogList
class Enrolment
class Activity
class Customer
class Dog
class "customer.Name" as CustomerName
class "customer.Phone" as CustomerPhone
class "customer.Email" as CustomerEmail
class BackupContact
class DogName
class Breed
class Size
}

ModelManager ..|> Model
ModelManager --> "1" AddressBook
ModelManager --> "1" UserPrefs
Model ..> ReadOnlyAddressBook
Model ..> ReadOnlyUserPrefs
AddressBook ..|> ReadOnlyAddressBook
UserPrefs ..|> ReadOnlyUserPrefs
AddressBook *--> "1" UniqueCustomerList
AddressBook *--> "1" UniqueDogList
AddressBook *--> "0..*" Enrolment
UniqueCustomerList --> "*" Customer
UniqueDogList --> "*" Dog
Customer *--> CustomerName
Customer *--> CustomerPhone
Customer *--> CustomerEmail
Customer *--> BackupContact
Dog *--> DogName
Dog *--> Breed
Dog *--> Size
ModelManager --> "* filtered" Customer
ModelManager --> "* filtered" Dog
ModelManager --> "* filtered" Activity
ModelManager ..> Enrolment : enrols dogs

note bottom of Enrolment
  Stores activity and dog IDs plus an
  occurrence date, not object references.
end note

note bottom of Dog
  Stores its persistent dog ID and an
  optional customer ID for ownership.
end note
@enduml
