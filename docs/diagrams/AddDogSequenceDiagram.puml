@startuml
!include style.puml
skinparam arrowColor LOGIC_COLOR_T4

actor User
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Router LOGIC_COLOR
participant ":AddDogCommandParser" as Parser LOGIC_COLOR
participant "command:AddDogCommand" as Command LOGIC_COLOR
participant "dog:Dog" as Dog MODEL_COLOR
participant ":ModelManager" as Model MODEL_COLOR
participant ":AddressBook" as Book MODEL_COLOR

User -> Logic : execute("adddog n/Cookie b/Golden Retriever s/Large")
Logic -> Router : parseCommand(...)
Router -> Parser : parse("n/Cookie b/Golden Retriever s/Large")
Parser -> Parser : validate dog fields
Parser -> Dog : new Dog(name, breed, size)
Parser -> Command : new AddDogCommand(dog)
Parser --> Router : command
Router --> Logic : command
Logic -> Command : execute(Model)
Command -> Model : addDog(dog)
Model -> Book : addDog(dog)
Book -> Book : assign next persistent dog ID
Book --> Model : added dog
Model --> Command : added dog
Command --> Logic : CommandResult
Logic --> User : display result
@enduml
