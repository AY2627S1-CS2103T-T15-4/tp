@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF
skinparam maxMessageSize 180
title Parse delete-dog command

participant ":LogicManager" as Logic LOGIC_COLOR
participant ":WatchDogParser" as Router LOGIC_COLOR
participant ":DeleteDogCommandParser" as Parser LOGIC_COLOR
participant "command:DeleteDogCommand" as Command LOGIC_COLOR

Logic -> Router : parseCommand("deletedog 1")
create Parser
Router -> Parser : new DeleteDogCommandParser()
Router -> Parser : parse(" 1")
create Command
Parser -> Command : new DeleteDogCommand(1)
Parser --> Router : command
Router --> Logic : command

legend bottom
  Expands the architecture diagram's "Parse delete-dog command" reference.
  LogicManager then executes the returned command and saves.
  Validation failures, activation bars and disposal are omitted.
endlegend
@enduml
