@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":WatchDogParser" as WatchDogParser LOGIC_COLOR
participant ":DeleteDogCommandParser" as DeleteDogCommandParser LOGIC_COLOR
participant "d:DeleteDogCommand" as DeleteDogCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:ModelManager" as ModelManager MODEL_COLOR
participant "b:WatchDog" as WatchDog MODEL_COLOR
end box

[-> LogicManager : execute("deletedog 1")
activate LogicManager

LogicManager -> WatchDogParser : parseCommand("deletedog 1")
activate WatchDogParser

create DeleteDogCommandParser
WatchDogParser -> DeleteDogCommandParser
activate DeleteDogCommandParser

DeleteDogCommandParser --> WatchDogParser
deactivate DeleteDogCommandParser

WatchDogParser -> DeleteDogCommandParser : parse("1")
activate DeleteDogCommandParser

create DeleteDogCommand
DeleteDogCommandParser -> DeleteDogCommand
activate DeleteDogCommand

DeleteDogCommand --> DeleteDogCommandParser :
deactivate DeleteDogCommand

DeleteDogCommandParser --> WatchDogParser : d
deactivate DeleteDogCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DeleteDogCommandParser -[hidden]-> WatchDogParser
destroy DeleteDogCommandParser

WatchDogParser --> LogicManager : d
deactivate WatchDogParser

LogicManager -> DeleteDogCommand : execute(m)
activate DeleteDogCommand

DeleteDogCommand -> ModelManager : deleteDog(dog)
activate ModelManager

ModelManager -> WatchDog : removeDog(dog)
activate WatchDog
WatchDog -> WatchDog : remove all enrolments for dog ID
WatchDog -> WatchDog : remove dog record
WatchDog --> ModelManager
deactivate WatchDog

ModelManager --> DeleteDogCommand
deactivate ModelManager

create CommandResult
DeleteDogCommand -> CommandResult
activate CommandResult

CommandResult --> DeleteDogCommand
deactivate CommandResult

DeleteDogCommand --> LogicManager : r
deactivate DeleteDogCommand

[<--LogicManager
deactivate LogicManager
@enduml
