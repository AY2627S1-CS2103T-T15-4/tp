@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":AddressBookParser" as AddressBookParser LOGIC_COLOR
participant ":DeleteDogCommandParser" as DeleteDogCommandParser LOGIC_COLOR
participant "d:DeleteDogCommand" as DeleteDogCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("delete dog 1")
activate LogicManager

LogicManager -> AddressBookParser : parseCommand("delete dog 1")
activate AddressBookParser

create DeleteDogCommandParser
AddressBookParser -> DeleteDogCommandParser
activate DeleteDogCommandParser

DeleteDogCommandParser --> AddressBookParser
deactivate DeleteDogCommandParser

AddressBookParser -> DeleteDogCommandParser : parse("1")
activate DeleteDogCommandParser

create DeleteDogCommand
DeleteDogCommandParser -> DeleteDogCommand
activate DeleteDogCommand

DeleteDogCommand --> DeleteDogCommandParser :
deactivate DeleteDogCommand

DeleteDogCommandParser --> AddressBookParser : d
deactivate DeleteDogCommandParser
'Hidden arrow to position the destroy marker below the end of the activation bar.
DeleteDogCommandParser -[hidden]-> AddressBookParser
destroy DeleteDogCommandParser

AddressBookParser --> LogicManager : d
deactivate AddressBookParser

LogicManager -> DeleteDogCommand : execute(m)
activate DeleteDogCommand

DeleteDogCommand -> Model : deleteDog(dog)
activate Model

Model --> DeleteDogCommand
deactivate Model

create CommandResult
DeleteDogCommand -> CommandResult
activate CommandResult

CommandResult --> DeleteDogCommand
deactivate CommandResult

DeleteDogCommand --> LogicManager : r
deactivate DeleteDogCommand

[<--LogicManager
deactivate LogicManager
@enduml
