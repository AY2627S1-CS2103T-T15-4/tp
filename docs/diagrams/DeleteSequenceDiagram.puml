@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF
skinparam maxMessageSize 180

participant ":AddressBookParser" as Router LOGIC_COLOR
participant ":DeleteDogCommandParser" as Parser LOGIC_COLOR
participant ":DeleteDogCommand" as Command LOGIC_COLOR

create Parser
Router -> Parser : new DeleteDogCommandParser()
Router -> Parser : parse(" 1")
create Command
Parser -> Command : new DeleteDogCommand(1)
Parser --> Router : command

legend bottom
  Inside parseCommand("delete dog 1").
  LogicManager then executes the returned command and saves.
  Validation failures, activation bars and disposal are omitted.
endlegend
@enduml
