@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

class WatchDogParser
class "<<interface>>\nParser" as Parser
class AddDogCommandParser
class AddDogCommand
class CliSyntax
class ParserUtil
class ArgumentMultimap
class ArgumentTokenizer
class Prefix

WatchDogParser ..> AddDogCommandParser : creates
AddDogCommandParser .up.|> Parser
AddDogCommandParser ..> AddDogCommand : creates
AddDogCommandParser ..> ArgumentTokenizer : tokenizes
AddDogCommandParser ..> ArgumentMultimap : reads
AddDogCommandParser ..> CliSyntax : uses prefixes
AddDogCommandParser ..> ParserUtil : parses values
ArgumentTokenizer ..> ArgumentMultimap : creates
ArgumentTokenizer ..> Prefix
ArgumentMultimap --> "*" Prefix : keys
CliSyntax ..> Prefix : defines constants

@enduml
