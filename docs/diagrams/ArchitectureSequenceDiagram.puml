@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF
skinparam maxMessageSize 180

actor User USER_COLOR
participant ":MainWindow" as UI UI_COLOR
participant ":LogicManager" as Logic LOGIC_COLOR
participant "command:DeleteDogCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR
participant ":StorageManager" as Storage STORAGE_COLOR

User -> UI : deletedog 1
UI -> Logic : execute("deletedog 1")
ref over Logic, Command
  Parse deletedog 1 and return command
end ref
Logic -> Model : createState()
Model --> Logic : stateBeforeCommand
Logic -> Command : execute(model)
Command -> Model : getDogList()
Model --> Command : dogs
note over Command
  Finds dog with persistent ID 1.
end note
Command -> Model : deleteDog(dog)
Command --> Logic : commandResult
note right of Logic
  Keeps the pre-command state for undo
  and clears redo before saving.
end note
Logic -> Model : getWatchDog()
Model --> Logic : watchDog
Logic -> Storage : saveWatchDog(watchDog)
Logic --> UI : commandResult
UI --> User : feedback displayed

legend bottom
  Successful deletion and saving; model and storage internals are omitted.
  Parser construction is expanded in the Logic sequence.
  Observable-list updates refresh the UI; notifications are omitted.
endlegend
@enduml
