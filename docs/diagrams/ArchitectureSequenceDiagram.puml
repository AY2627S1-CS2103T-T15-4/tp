@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF
skinparam maxMessageSize 180

actor User USER_COLOR
participant ":MainWindow" as UI UI_COLOR
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR
participant ":StorageManager" as Storage STORAGE_COLOR

User -> UI : delete dog 1
UI -> Logic : execute("delete dog 1")
Logic -> Model : getDogList()
Model --> Logic : dogs
Logic -> Model : deleteDog(dog)
Logic -> Model : getAddressBook()
Model --> Logic : addressBook
Logic -> Storage : saveAddressBook(addressBook)
Logic --> UI : commandResult
UI --> User : feedback displayed

legend bottom
  Successful deletion at component boundaries; internal calls are omitted.
  Calls made by DeleteDogCommand are represented by its Logic component.
  Observable-list updates refresh the UI; notifications are omitted.
endlegend
@enduml
