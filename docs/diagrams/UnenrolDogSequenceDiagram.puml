@startuml
!include style.puml
skinparam arrowColor LOGIC_COLOR_T4

actor User
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":AddressBookParser" as Router LOGIC_COLOR
participant ":UnenrolDogCommandParser" as Parser LOGIC_COLOR
participant "command:UnenrolDogCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR
participant ":AddressBook" as Book MODEL_COLOR

User -> Logic : execute("unenrol a/1 date/2028-02-29 d/2,3")
Logic -> Router : parseCommand(...)
Router -> Parser : parse("a/1 date/2028-02-29 d/2,3")
Parser -> Parser : parse activity ID, date and dog IDs
Parser -> Command : new UnenrolDogCommand(1, 2028-02-29, [2, 3])
Parser --> Router : command
Router --> Logic : command
Logic -> Command : execute(Model)
Command -> Model : unenrolDogs(1, 2028-02-29, [2, 3])
Model -> Book : unenrolDogs(1, 2028-02-29, [2, 3])
Book -> Book : validate occurrence and exact enrolments
Book --> Model : success or EnrolException
Model --> Command : result
Command --> Logic : CommandResult
Logic --> User : display result
@enduml
