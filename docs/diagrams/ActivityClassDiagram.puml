/'
// @@author Kenneth-Chia
'/
@startuml
!include style.puml
skinparam arrowColor MODEL_COLOR_T4
skinparam classBackgroundColor MODEL_COLOR
skinparam ArrowFontStyle plain
show members
/'
// @@author
'/

class WatchDog {
/'
// @@author Kenneth-Chia
'/
  -nextActivityId: long
  +addActivity(...): Activity
/'
// @@author
'/
  +removeActivity(activity: Activity): void
/'
// @@author Kenneth-Chia
'/
  +setActivity(target, editedActivity): void
  +enrolDogs(activityId, date, dogIds): void
  +unenrolDogs(activityId, date, dogIds): void
}

class Activity {
  -id: int
  -startDate: LocalDate
  -startTime: LocalTime
  -endTime: LocalTime
  +occursOn(date: LocalDate): boolean
  +nextOccurrenceOnOrAfter(...)
}

class Enrolment {
/'
// @@author
'/
  -activityId: int
  -dogId: int
  -date: LocalDate
}

/'
// @@author Kenneth-Chia
'/
class ActivityName {
  +fullName: String
}

class "<<enumeration>>\nRecurrence" as Recurrence {
  ONCE
  DAILY
  WEEKLY
}

WatchDog --> "*" Activity : activities
WatchDog --> "*" Enrolment : enrolments
Activity --> "1" ActivityName : name
Activity --> "1" Recurrence : recurrence

note bottom of Enrolment
  IDs identify the stored activity and dog;
  these are not object references.
end note

note bottom of Activity
  Immutable schedule.
  Recurrence is calculated;
  enrolments are stored separately.
end note
@enduml
/'
// @@author
