@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

/'
// @@author Kenneth-Chia
'/
class "<<interface>>\nUi" as Ui
class UiManager
class MainWindow
class CommandBox
class ResultDisplay
class HelpWindow
class CustomerListPanel
class DogListPanel
class ActivityBookingSummary
class CardListUpdater
class ActivityListPanel
class TodayActivityListPanel
class CustomerCard
class DogCard
class ActivityCard
class "<<interface>>\nLogic" as Logic LOGIC_COLOR

UiManager .up.|> Ui
UiManager --> "1" MainWindow : mainWindow
UiManager --> "1" Logic : logic
MainWindow --> "1" Logic : logic
MainWindow -left-> "1" ResultDisplay
MainWindow -right-> "1" HelpWindow
MainWindow --> "1" CustomerListPanel
MainWindow --> "1" DogListPanel
MainWindow --> "1" ActivityListPanel
MainWindow --> "1" TodayActivityListPanel
MainWindow .left.> CommandBox : creates
TodayActivityListPanel -up-|> ActivityListPanel
CustomerListPanel ..> CustomerCard : creates
DogListPanel ..> DogCard : creates
ActivityListPanel ..> ActivityCard : creates
ActivityListPanel ..> ActivityBookingSummary : formats booking lines
ActivityListPanel ..> CardListUpdater : reconciles cards
CustomerListPanel ..> CardListUpdater
DogListPanel ..> CardListUpdater

note right of ActivityListPanel
  Observes activity, enrolment and search-context
  changes to refresh per-dog enrolment dates.
end note
/'
// @@author
'/

/'
// @@author Kenneth-Chia
'/
note bottom of TodayActivityListPanel
  Uses all schedules and exact-date bookings.
  General panel shows bookings today or later.
  MainWindow refreshes both with one date
  after successful commands.
/'
// @@author
'/
end note
@enduml
