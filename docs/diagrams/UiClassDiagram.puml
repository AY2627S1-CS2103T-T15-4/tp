@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>>{
Class "<<interface>>\nUi" as Ui
Class "{abstract}\nUiPart" as UiPart
Class UiManager
Class MainWindow
Class HelpWindow
Class ResultDisplay
Class RecordListPanel
Class ActivityListPanel
Class TodayActivityListPanel
Class CustomerCard
Class DogCard
Class StatusBarFooter
Class CommandBox
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .left.|> Ui
UiManager -down-> "1" MainWindow
MainWindow *-down->  "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" RecordListPanel
MainWindow *-down-> "1" ActivityListPanel
MainWindow *-down-> "1" TodayActivityListPanel
MainWindow *-down-> "1" StatusBarFooter
MainWindow --> "0..1" HelpWindow

RecordListPanel -down-> "*" CustomerCard
RecordListPanel --> "*" DogCard
TodayActivityListPanel --|> ActivityListPanel

MainWindow -left-|> UiPart

ResultDisplay --|> UiPart
CommandBox --|> UiPart
RecordListPanel --|> UiPart
ActivityListPanel --|> UiPart
CustomerCard --|> UiPart
DogCard --|> UiPart
StatusBarFooter --|> UiPart
HelpWindow --|> UiPart

CustomerCard ..> Model
DogCard ..> Model
UiManager -right-> Logic
MainWindow -left-> Logic

RecordListPanel -[hidden]left- HelpWindow
TodayActivityListPanel -[hidden]right- ActivityListPanel
HelpWindow -[hidden]left- CommandBox
CommandBox -[hidden]left- ResultDisplay
ResultDisplay -[hidden]left- StatusBarFooter

MainWindow -[hidden]-|> UiPart

note right of TodayActivityListPanel
  Filters the shared activity list
  to schedules occurring today.
end note
@enduml
