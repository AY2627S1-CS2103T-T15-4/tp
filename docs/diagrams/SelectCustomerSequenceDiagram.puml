@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF
skinparam maxMessageSize 180

participant "command:SelectCustomerCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR

[-> Command : execute(model)
Command -> Model : getCustomerList()
Model --> Command : customers
note over Command
  Finds the customer with persistent ID 21.
end note
Command -> Model : selectCustomer(21)
note right of Model
  Tracks the selected customer ID.
  Shows the customer, owned dogs, and activities
  with those dogs enrolled today or later.
end note
[<-- Command : commandResult

legend bottom
  Selects customer 21. Model internals are omitted.
  Parsing and saving follow the shared Logic flow.
  Successful execution only; validation failures are omitted.
endlegend
@enduml
