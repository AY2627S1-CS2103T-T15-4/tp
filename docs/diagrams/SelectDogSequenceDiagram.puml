@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF
skinparam maxMessageSize 180

participant "command:SelectDogCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR

[-> Command : execute(model)
Command -> Model : getDogList()
Model --> Command : dogs
note over Command
  Finds the dog with persistent ID 21.
end note
Command -> Model : selectDog(21)
note right of Model
  Tracks the selected dog ID.
  Shows the dog, its owner, and activities
  with enrolments today or later.
end note
[<-- Command : commandResult

legend bottom
  Selects dog 21. Model internals are omitted.
  Parsing and saving follow the shared Logic flow.
  Successful execution only; validation failures are omitted.
endlegend
@enduml
