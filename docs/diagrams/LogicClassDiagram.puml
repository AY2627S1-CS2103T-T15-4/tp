@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {
class "<<interface>>\nLogic" as Logic
class LogicManager
class WatchDogParser
class "{abstract}\nCommand" as Command
class AddDogCommand
class SummaryCommand
class CommandResult
}

class "<<interface>>\nModel" as Model MODEL_COLOR
class "<<interface>>\nStorage" as Storage STORAGE_COLOR

LogicManager .up.|> Logic
LogicManager --> "1" WatchDogParser : watchDogParser
LogicManager --> "1" Model : model
LogicManager --> "1" Storage : storage
LogicManager ..> Command : executes
WatchDogParser ..> Command : returns
AddDogCommand -up-|> Command
SummaryCommand -up-|> Command
Command ..> Model : execute(model)
Command ..> CommandResult : returns
Logic ..> CommandResult : returns

note bottom of AddDogCommand
  Representative command subclasses.
  Other commands and parser internals
  are omitted.
end note

note bottom of LogicManager
  Handles undo/redo snapshots and clear confirmation.
  History fields and commands are omitted.
end note
@enduml
