<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <GridPane HBox.hgrow="ALWAYS">
    <columnConstraints>
      <ColumnConstraints hgrow="SOMETIMES" minWidth="10" prefWidth="150" />
    </columnConstraints>
    <VBox alignment="CENTER_LEFT" minHeight="105" spacing="2" GridPane.columnIndex="0">
      <padding>
        <Insets top="10" right="14" bottom="10" left="14" />
      </padding>
      <HBox fx:id="header" spacing="0.5" alignment="CENTER_LEFT">
        <Label fx:id="id" styleClass="cell_big_label">
          <minWidth>
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
        <Label fx:id="name" styleClass="cell_big_label" />
        <Label fx:id="headerTime" styleClass="cell_small_label" style="-fx-font-weight: bold;">
          <HBox.margin>
            <Insets left="16" />
          </HBox.margin>
          <minWidth>
            <Region fx:constant="USE_PREF_SIZE" />
          </minWidth>
        </Label>
      </HBox>
      <Label fx:id="date" styleClass="cell_small_label" />
      <Label fx:id="time" styleClass="cell_small_label" />
      <Label fx:id="recurrence" styleClass="cell_small_label" />
      <Label fx:id="dogSummary" lineSpacing="1" styleClass="cell_small_label" wrapText="true"
          maxWidth="Infinity" />
      <Label fx:id="enrolmentsHeading" text="&#10;Enrolments:" styleClass="cell_small_label"
             style="-fx-font-weight: bold;" />
      <Label fx:id="enrolments" styleClass="cell_small_label" wrapText="true" />
    </VBox>
  </GridPane>
</HBox>
