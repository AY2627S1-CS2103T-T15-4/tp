@startuml
!include style.puml
skinparam ArrowFontStyle plain
skinparam ParticipantFontColor #FFFFFF
skinparam maxMessageSize 180

participant "command:SearchCustomerCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR

[-> Command : execute(model)
note over Command
  Builds matchingCustomer for name Anna.
  Related predicates follow current ownership
  and dated enrolment records.
end note
Command -> Model : updateFilteredCustomerList(matchingCustomer)
Command -> Model : updateFilteredDogList(ownedDogPredicate)
Command -> Model : updateFilteredActivityList(enrolledActivityPredicate)
Command -> Model : setActivityEnrolmentDogPredicate(ownedDogPredicate)
note right of Model
  Retains predicates for later refreshes.
  Activity cards show matching dogs'
  sorted stored enrolment dates.
  Stored records are unchanged.
end note
[<-- Command : commandResult

legend bottom
  Searches by name without an ID criterion. Predicate evaluation is omitted.
  Parsing and saving follow the shared Logic flow.
  Successful execution only; validation failures are omitted.
endlegend
@enduml
