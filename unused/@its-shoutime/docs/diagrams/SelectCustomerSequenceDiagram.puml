@startuml
'' Archived because select customer is not part of the final product.
!include style.puml
skinparam arrowColor LOGIC_COLOR_T4

actor User
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":WatchDogParser" as Router LOGIC_COLOR
participant ":SelectCommandParser" as SelectParser LOGIC_COLOR
participant ":SelectCustomerCommandParser" as Parser LOGIC_COLOR
participant "command:SelectCustomerCommand" as Command LOGIC_COLOR
participant ":ModelManager" as Model MODEL_COLOR
participant ":WatchDog" as Book MODEL_COLOR

User -> Logic : execute("select customer 21")
Logic -> Router : parseCommand(...)
Router -> SelectParser : parse(" customer 21")
SelectParser -> Parser : parse(" customer 21")
Parser -> Parser : validate "customer" and ID starting at 1
Parser -> Command : new SelectCustomerCommand(21)
Parser --> SelectParser : command
SelectParser --> Router : command
Router --> Logic : command
Logic -> Command : execute(Model)
Command -> Model : getCustomerList()
Model --> Command : customers
Command -> Model : selectCustomer(21)
Model -> Book : read current customer, owned dogs and enrolments
Book --> Model : current records
Model -> Model : filter customer, owned dogs and future/current enrolments
Command --> Logic : CommandResult
Logic --> User : display result
@enduml
